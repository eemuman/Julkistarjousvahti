# Hilma AVP-Read -avain (ilmainen): https://hns-hilma-prod-apim.developer.azure-api.net -> Products -> avp-read -> Subscribe
HILMA_API_KEY=

# Avain Google AI Studiosta: https://aistudio.google.com/apikey (vain tähän tiedostoon)
GEMINI_API_KEY=
# Mallin voi vaihtaa tästä (oletus gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Eräajon AI-asetukset (oletukset suluissa)
# AI_CONCURRENCY=2          samanaikaiset AI-kutsut, 1–5 (2)
# AI_MIN_INTERVAL_MS=4000   väli kutsujen aloitusten välillä, 0–60000 (4000)
# AI_MAX_ASSESSMENTS=150    enimmäismäärä AI-kutsuja per ajo, 0–1000 (150)
# AI_TIME_BUDGET_MIN=40     aikabudjetti ajon alusta minuutteina, 1–40 (40). Jäljelle jäävät arvioidaan seuraavalla ajolla.

# Edellinen data.json, jonka arvioita käytetään uudelleen (URL tai tiedostopolku).
# Ilman asetusta käytetään tulostiedostoa, jos se on olemassa (npm-skriptit kirjoittavat web/public/data.json:iin). Ks. docs/ARCHITECTURE.md.
# PREVIOUS_DATA=https://<käyttäjä>.github.io/<repo>/data.json

# Web-buildin alipolku, esim. GitHub Pages /<repo>/. Oletus /. Asetetaan komentoriville, ei .env-tiedostoon.
# VITE_BASE=/<repo>/
